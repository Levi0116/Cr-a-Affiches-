# Copier ce fichier en .env et remplir. Ne jamais publier le fichier .env.

# Port interne (Nginx redirige le HTTPS public vers ce port)
PORT=3000

# Base MySQL (utilisateur dédié, droits limités à cette base)
MYSQL_HOTE=127.0.0.1
MYSQL_PORT=3306
MYSQL_BASE=amani
MYSQL_UTILISATEUR=amani
MYSQL_MOT_DE_PASSE=changez-moi

# Secret de signature des sessions : 64 caractères aléatoires minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_SESSIONS=

# Durée d'une session employé (heures)
DUREE_SESSION_H=12

# Dossier de la PWA construite (flutter build web)
DOSSIER_PWA=../build/web

# Version de l'application proposée aux appareils
VERSION_DERNIERE=2.0.0
VERSION_MINIMALE=2.0.0
VERSION_NOTES=
