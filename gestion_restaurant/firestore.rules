rules_version = '2';

// Règles de sécurité (section 6.6 du cahier des charges).
//
// Chaque appareil lié reçoit, via une Cloud Function, un compte Firebase
// portant le jeton personnalisé `restaurantId` (et `admin: true` pour le
// téléphone du gérant). Un appareil ne lit et n'écrit que les données de
// SON restaurant. Rien n'est jamais supprimé.
//
// ⚠ À tester avec l'émulateur Firebase (phase 10.2) avant la production.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function monResto(rid) { return connecte() && request.auth.token.restaurantId == rid; }
    function admin(rid) { return monResto(rid) && request.auth.token.admin == true; }
    function champsModifies() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function seulement(champs) { return champsModifies().hasOnly(champs); }
    function parametrage() {
      return ['employes', 'zones', 'categories', 'fournisseurs', 'depenses', 'historiquePrix', 'appareils'];
    }
    function journaux() {
      return ['encaissements', 'mouvementsStock', 'journalAudit', 'livraisons'];
    }

    match /restaurants/{rid} {
      allow read: if monResto(rid);
      allow create, update: if admin(rid);
      allow delete: if false;

      // Collections génériques :
      // - paramétrage : écriture réservée à l'administrateur ;
      // - journaux : ajout seul, jamais modifiés ni supprimés.
      match /{col}/{id} {
        allow read: if monResto(rid)
          && (col in parametrage() || col in journaux());
        allow create: if (col in parametrage() && admin(rid))
          || (col in journaux() && monResto(rid));
        allow update: if col in parametrage() && admin(rid);
        allow delete: if false;
      }

      // Articles : prix et menu réservés à l'admin ; les autres appareils ne
      // peuvent toucher qu'au stock, aux ventes, à la disponibilité et au coût.
      match /articles/{id} {
        allow read: if monResto(rid);
        allow create: if admin(rid);
        allow update: if admin(rid)
          || (monResto(rid) && seulement(['stock', 'nbVentes', 'disponible', 'coutMoyen', 'seuilAlerte', 'modifieLe', 'modifiePar']));
        allow delete: if false;
      }

      // Tables : l'état (libre/occupée/addition) change en service.
      match /tables/{id} {
        allow read: if monResto(rid);
        allow create: if admin(rid);
        allow update: if admin(rid) || (monResto(rid) && seulement(['statut', 'idSession']));
        allow delete: if false;
      }

      match /sessions/{id} {
        allow read, create, update: if monResto(rid);
        allow delete: if false;
        match /lignes/{ligne} {
          allow read, create: if monResto(rid);
          // Une ligne n'est jamais supprimée. Son annulation (statut,
          // validePar) passe par une validation de l'administrateur.
          allow update: if admin(rid)
            || (monResto(rid) && seulement(['annulationDemandee', 'idFacture']));
          allow delete: if false;
        }
      }

      // Factures : une facture payée n'est jamais modifiée (correction par avoir).
      match /factures/{id} {
        allow read, create: if monResto(rid);
        allow update: if monResto(rid) && (
          (resource.data.statut == 'emise'
            && seulement(['statut', 'montantRecu', 'monnaieRendue', 'payeeLe', 'idJournee', 'idArdoise', 'nbImpressions']))
          || seulement(['nbImpressions']));
        allow delete: if false;
      }

      match /avoirs/{id} {
        allow read: if monResto(rid);
        allow create: if admin(rid);
        allow update, delete: if false;
      }

      match /journeesCaisse/{id} {
        allow read, create: if monResto(rid);
        // Journée verrouillée après la clôture.
        allow update: if monResto(rid) && resource.data.verrouillee == false;
        allow delete: if false;
      }

      match /ardoises/{id} {
        allow read, create, update: if monResto(rid);
        allow delete: if false;
        match /remboursements/{r} {
          allow read, create: if monResto(rid);
          allow update, delete: if false;
        }
      }

      match /demandesValidation/{id} {
        allow read, create: if monResto(rid);
        allow update: if admin(rid);
        allow delete: if false;
      }

      match /compteurs/{id} {
        allow read, write: if monResto(rid);
      }

      match /rapportsJour/{id} {
        allow read: if monResto(rid);
        allow write: if false; // écrit uniquement par les Cloud Functions
      }
    }
  }
}
